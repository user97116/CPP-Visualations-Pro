{
  "name": "cpp-flow-studio",
  "displayName": "C++ Flow Studio",
  "description": "Flow Studio visualization synced with VS Code debugging (F5).",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "cppFlowStudio.flowView",
          "name": "Flow Studio",
          "when": "inDebugMode",
          "icon": "$(graph-line)",
          "contextualTitle": "Flow Studio"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
